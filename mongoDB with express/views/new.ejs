<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Write Chat</title>
</head>
<body>
    <h3>Write new Chat</h3>
    <form method="post" action="/chats">
        <input type="text" name="from" placeholder="who are you?">
        <br> <br>
        <textarea name="msg" placeholder="write your message"></textarea>
        <br> <br>
        <input type="text" name="to" placeholder="add receiver">
        <br><br>
        <button type="submit">Send</button>
    </form>
</body>
</html>