<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit your chat</title>
</head>
<body>
    <h3><i>Edit your chats: <%=chat._id%></i></h3>
    <p>This is sent from <b><%=chat.from%></b> to <b><%=chat.to%></b></p>
    <br> <br>
    <form method="post" action="/chats/<%=chat._id%>?_method=PUT">
    <textarea name="msg" rows="5px" cols="20px"><%=chat.msg%></textarea>
    <br>
    <button>Edit</button>
    </form>
</body>
</html>