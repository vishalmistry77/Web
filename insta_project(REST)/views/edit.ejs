<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Post</title>
</head>
<body>
    <h2>Edit your post</h2>
    <p>Post id: <%=feed.id%></p>
    <p>Username: @<%=feed.username%></p>
    <img class="image" src="<%=feed.image%>" alt="Image">
    <form method="post" action="/feeds/<%=feed.id%>?_method=PATCH">
        <textarea rows="10" cols="35" name="caption"><%=feed.caption%></textarea>
        <br> &nbsp;
        <button>Submit</button>
    </form>
</body>
</html>